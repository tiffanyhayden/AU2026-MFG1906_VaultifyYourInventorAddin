<Window x:Class="VaultifyYourInventorAddin.BoxForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VaultifyYourInventorAddin"
        mc:Ignorable="d"
        Title="Box Design Requirements" Height="260" Width="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Length" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox x:Name="LengthCombo" Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8" SelectionChanged="LengthCombo_SelectionChanged" IsEditable="True"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox x:Name="WidthCombo" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8" SelectionChanged="WidthCombo_SelectionChanged" IsEditable="True"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Depth" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox x:Name="DepthCombo" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,8" SelectionChanged="DepthCombo_SelectionChanged" IsEditable="True"/>

        <TextBlock x:Name="ValidationText" Grid.Row="3" Grid.Column="1" Text="" HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="11"/>

        <Button x:Name="CreateButton" Grid.Row="5" Grid.Column="1" Content="Create"
                Width="80" Height="26" HorizontalAlignment="Right"
                IsDefault="True" Click="CreateButton_Click"/>
    </Grid>
</Window>
